# QBank API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Development-Only Authentication Bypass Preview Mode
# Set to "true" to enable preview mode when backend is unavailable.
# Only functions in development (import.meta.env.DEV === true).
# Set to "false" to test normal login/registration flows.
VITE_DEV_AUTH_BYPASS=false
